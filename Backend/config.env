# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://postgres:5432/nimbus
DB_USERNAME=postgres
DB_PASSWORD=postgres

# GitHub OAuth Credentials
# Replace these with your actual GitHub OAuth App credentials for local testing
GITHUB_CLIENT_ID=your_local_github_client_id_here
GITHUB_CLIENT_SECRET=your_local_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8080/api/github/callback

# Kafka Configuration
# In docker-compose, this is mapped to kafka:29092. The docker-compose.yml already overrides SPRING_KAFKA_BOOTSTRAP_SERVERS, but setting it here as a fallback
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
